include LICENSE README.md SECURITY.md THIRD_PARTY.md CONTRIBUTING.md config.example.json compose.yaml setup_stack.py requirements.txt
recursive-include docs *.md
recursive-include examples *.json *.toml
recursive-include tests *.py
include scripts/check_release.py
prune runtime
prune .venv
prune .git
prune .codex
prune .claude
prune dist
prune build
global-exclude *.pyc *.db *.db-* *.sqlite* .env config.json session.json cookies.json
